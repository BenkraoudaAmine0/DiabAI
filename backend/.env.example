# ── Supabase (Project Settings → API) ─────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# ── Gemini (Google AI Studio API key) ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# USD per million tokens — used for the admin dashboard's cost estimate
GEMINI_INPUT_PRICE_PER_MTOK=0.10
GEMINI_OUTPUT_PRICE_PER_MTOK=0.40
GEMINI_EMBEDDING_PRICE_PER_MTOK=0.15

# ── Knowledge-base embeddings ─────────────────────────────────────────────────
# local  = free model on this machine (no API limits; ~1.2 GB downloaded once,
#          ~1.5 GB RAM while the API runs; ~15 min for a 1 100-page book)
# gemini = GEMINI_EMBEDDING_MODEL via the API (free tier ≈ 1 000 requests/day)
# Questions and documents must use the same model: after changing this,
# re-index the knowledge base (admin dashboard, or python scripts/ingest_kb.py).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m

# ── Knowledge base ────────────────────────────────────────────────────────────
# Chunks below this cosine similarity are ignored by the chatbot (0 = always top 5)
KB_MIN_SIMILARITY=0
# Admin upload size limits in MB (Supabase Storage free plan: 50 MB per file)
KB_MAX_DOCUMENT_MB=25
KB_MAX_BOOK_MB=100
# Images inside uploads (figures, charts, scanned pages) are read by Gemini:
# at most this many calls per document (0 = tables only, no image reading)
KB_MAX_VISION_CALLS=60
# Images smaller than this (px, either side) are ignored — icons, bullets, rules
KB_MIN_IMAGE_PX=120

# ── App ───────────────────────────────────────────────────────────────────────
# Where the frontend runs — invitation emails lead to
# FRONTEND_URL/auth/callback → /set-password. Allow FRONTEND_URL/** in
# Supabase → Authentication → URL Configuration → Redirect URLs.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Hugging Face ─────────────────────────────────────────────────────────────
# Read token for downloading private model artifacts & speeding up HF Hub downloads
HF_TOKEN=your-huggingface-read-token
HF_MODEL_REPO_ID=BenkraoudaAmine/diabai-models

