# ── Supabase (Project Settings → API) ─────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# ── Gemini (Google AI Studio API key) ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# USD per million tokens — used for the admin dashboard's cost estimate
GEMINI_INPUT_PRICE_PER_MTOK=0.10
GEMINI_OUTPUT_PRICE_PER_MTOK=0.40
GEMINI_EMBEDDING_PRICE_PER_MTOK=0.15

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
# Where the frontend runs — invite emails redirect the patient here:
FRONTEND_URL=http://localhost:3000
